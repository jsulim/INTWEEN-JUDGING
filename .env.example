# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # 서버 전용. 절대 NEXT_PUBLIC_ 로 노출 금지

# 사이트 주소 (초대·비밀번호 재설정 메일의 리다이렉트 기준)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# n8n 웹훅 (10장). 비워두면 이벤트 전송을 건너뛴다.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# 심사위원 정산 정보(계좌·주민번호) 암호화 키: 32바이트 base64. 생성: openssl rand -base64 32
PAYMENT_ENC_KEY=

# PPTX→PDF 변환 서비스(선택, Gotenberg 호환 /forms/libreoffice/convert). 비우면 변환 생략
PPTX_CONVERT_URL=

# Vercel Cron / 외부 스케줄러가 /api/cron/* 호출 시 사용하는 비밀값
CRON_SECRET=

# 관리자 2단계 인증(OTP) 강제 여부. 모의 심사 등 테스트 시에만 false
REQUIRE_ADMIN_MFA=true
